{
  "features": {
    "bot_user": {
      "display_name": "OpenAgent",
      "always_online": false
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "https://auth.openagent.uno/v1/channels/slack/oauth/callback"
    ],
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "groups:history",
        "groups:read"
      ]
    }
  },
  "settings": {
    "token_rotation_enabled": true,
    "event_subscriptions": {
      "request_url": "https://auth.openagent.uno/v1/channels/slack/events",
      "bot_events": [
        "app_mention",
        "app_uninstalled",
        "tokens_revoked"
      ]
    }
  }
}
