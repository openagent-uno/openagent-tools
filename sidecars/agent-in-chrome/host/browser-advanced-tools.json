[
  {"name":"browser_capabilities","description":"Inspect configured browser IDs and actual backend features. Browser IDs are host-configured; no endpoint argument is accepted.","classification":"read_only","inputSchema":{"type":"object","properties":{"browser_id":{"type":"string"}},"additionalProperties":false}},
  {"name":"browser_control","description":"List, attach or detach an explicit browser/tab, request human takeover or inspect recovery. Resume requires host-signed metadata and never accepts approval proof in tool arguments.","classification":"mutating","classification_by_argument":{"action":{"inventory":"read_only","recover":"read_only"}},"inputSchema":{"type":"object","properties":{"browser_id":{"type":"string"},"action":{"type":"string","enum":["inventory","attach","detach","request_takeover","resume","recover"]},"tabId":{"type":"integer","minimum":1},"reason":{"type":"string","maxLength":1000},"request_id":{"type":"string"}},"required":["action"],"additionalProperties":false}},
  {"name":"browser_frames","description":"List exact frame/document handles for one tab, including cross-origin frames supported by Chromium. Re-discover after navigation or detach.","classification":"read_only","inputSchema":{"type":"object","properties":{"browser_id":{"type":"string"},"tabId":{"type":"integer","minimum":1}},"required":["tabId"],"additionalProperties":false}},
  {"name":"browser_locate","description":"Find semantic or CSS locators with bounded attached/visible/hidden/detached waits. Returns document-bound opaque element refs; never chooses the first ambiguous match.","classification":"read_only","inputSchema":{"type":"object","properties":{"browser_id":{"type":"string"},"tabId":{"type":"integer","minimum":1},"frame_ref":{"type":"string"},"locator":{"type":"object","properties":{"role":{"type":"string"},"name":{"type":"string"},"text":{"type":"string"},"label":{"type":"string"},"placeholder":{"type":"string"},"test_id":{"type":"string"},"css":{"type":"string"},"exact":{"type":"boolean"}},"additionalProperties":false},"wait_for":{"type":"string","enum":["attached","visible","hidden","detached"]},"timeout_ms":{"type":"integer","minimum":1,"maximum":30000}},"required":["tabId","locator"],"additionalProperties":false}},
  {"name":"browser_action","description":"Act on exactly one current element ref or locator, with bounded readiness waits. Pins the actual element and document; no mutation replay after cancellation or uncertain execution.","classification":"mutating","inputSchema":{"type":"object","properties":{"browser_id":{"type":"string"},"tabId":{"type":"integer","minimum":1},"frame_ref":{"type":"string"},"document_id":{"type":"string"},"element_ref":{"type":"string"},"locator":{"type":"object","properties":{"role":{"type":"string"},"name":{"type":"string"},"text":{"type":"string"},"label":{"type":"string"},"placeholder":{"type":"string"},"test_id":{"type":"string"},"css":{"type":"string"},"exact":{"type":"boolean"}},"additionalProperties":false},"action":{"type":"string","enum":["click","fill","check","uncheck","select","press","hover","focus","scroll"]},"value":{"type":"string"},"key":{"type":"string","maxLength":100},"timeout_ms":{"type":"integer","minimum":1,"maximum":30000}},"required":["tabId","action"],"additionalProperties":false}},
  {"name":"browser_upload","description":"Set files on one exact file-input element. Inline base64 payloads or absolute paths within host-configured upload roots only; at most 10 files and 32 MiB total.","classification":"mutating","inputSchema":{"type":"object","properties":{"browser_id":{"type":"string"},"tabId":{"type":"integer","minimum":1},"frame_ref":{"type":"string"},"document_id":{"type":"string"},"element_ref":{"type":"string"},"locator":{"type":"object","properties":{"role":{"type":"string"},"name":{"type":"string"},"text":{"type":"string"},"label":{"type":"string"},"placeholder":{"type":"string"},"test_id":{"type":"string"},"css":{"type":"string"},"exact":{"type":"boolean"}},"additionalProperties":false},"files":{"type":"array","maxItems":10,"items":{"type":"object","properties":{"name":{"type":"string","maxLength":255},"mime_type":{"type":"string","maxLength":255},"data_base64":{"type":"string"},"path":{"type":"string"}},"additionalProperties":false}},"timeout_ms":{"type":"integer","minimum":1,"maximum":30000}},"required":["tabId","files"],"additionalProperties":false}},
  {"name":"browser_downloads","description":"Inspect, read bounded base64 chunks, cancel or explicitly release downloads belonging to one tab. No arbitrary host path is exposed or accepted.","classification":"mutating","classification_by_argument":{"action":{"list":"read_only","status":"read_only","read":"read_only"}},"inputSchema":{"type":"object","properties":{"browser_id":{"type":"string"},"tabId":{"type":"integer","minimum":1},"action":{"type":"string","enum":["list","status","read","cancel","release"]},"download_id":{"type":"string"},"offset":{"type":"integer","minimum":0,"maximum":33554432},"max_bytes":{"type":"integer","minimum":1,"maximum":1048576}},"required":["tabId","action"],"additionalProperties":false}},
  {"name":"browser_file_chooser","description":"Inspect or wait for a real page file chooser, then set or cancel its exact document-bound handle. Files use the same limits/policy as browser_upload.","classification":"mutating","classification_by_argument":{"action":{"list":"read_only","wait":"read_only"}},"inputSchema":{"type":"object","properties":{"browser_id":{"type":"string"},"tabId":{"type":"integer","minimum":1},"action":{"type":"string","enum":["list","wait","set","cancel"]},"chooser_id":{"type":"string"},"files":{"type":"array","maxItems":10,"items":{"type":"object","properties":{"name":{"type":"string","maxLength":255},"mime_type":{"type":"string","maxLength":255},"data_base64":{"type":"string"},"path":{"type":"string"}},"additionalProperties":false}},"timeout_ms":{"type":"integer","minimum":1,"maximum":30000}},"required":["tabId","action"],"additionalProperties":false}},
  {"name":"browser_permissions","description":"Query browser permission state or request a human decision for an exact origin. Grant/revoke require host-signed metadata; tool arguments cannot approve access.","classification":"mutating","classification_by_argument":{"action":{"query":"read_only"}},"inputSchema":{"type":"object","properties":{"browser_id":{"type":"string"},"tabId":{"type":"integer","minimum":1},"action":{"type":"string","enum":["query","request","grant","revoke"]},"origin":{"type":"string"},"permissions":{"type":"array","minItems":1,"maxItems":6,"uniqueItems":true,"items":{"type":"string","enum":["geolocation","notifications","camera","microphone","clipboard-read","clipboard-write"]}},"request_id":{"type":"string"}},"required":["tabId","action"],"additionalProperties":false}}
]
